{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "constraints": {
    "go": "1.27"
  },
  "dependencyDashboard": true,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "separateMinorPatch": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump golangci-lint version in the CI workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.ya?ml$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION:\\s*v?(?<currentValue>(?:\\d+\\.){1,2}\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "golangci/golangci-lint",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Bump git-cliff version in the changelog workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/changelog_version\\.ya?ml$/"
      ],
      "matchStrings": [
        "GIT_CLIFF_VERSION:\\s*v?(?<currentValue>(?:\\d+\\.){1,2}\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "orhun/git-cliff",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "groupName": "Github Actions updates",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "golang",
      "matchDatasources": [
        "docker",
        "go-version"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "/golang/"
      ]
    },
    {
      "groupName": "golangci-lint (CI)",
      "groupSlug": "golangci-lint",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "golangci/golangci-lint"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "git-cliff (changelog)",
      "groupSlug": "git-cliff",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "orhun/git-cliff"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "golang.org/x packages",
      "groupSlug": "golang-x-go",
      "matchDatasources": [
        "go"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "golang.org/x{/,}**"
      ]
    }
  ]
}
